FROM alpine:3.23

ARG TARGETPLATFORM

RUN apk add --no-cache ca-certificates tzdata bubblewrap
RUN addgroup -g 1000 picoclaw && adduser -D -u 1000 -G picoclaw picoclaw && \
    mkdir -p /data && chown picoclaw:picoclaw /data
ENV PICOCLAW_HOME=/data

COPY $TARGETPLATFORM/picoclaw /usr/local/bin/picoclaw
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh
USER picoclaw

ENTRYPOINT ["/entrypoint.sh"]
